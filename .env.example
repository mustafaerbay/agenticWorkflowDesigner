# Copy to .env (chmod 600) and replace every "change-me" value.
# Generate secrets with:  openssl rand -hex 32

ENVIRONMENT=development
LOG_LEVEL=INFO
IMAGE_TAG=dev

# Web entry point (the only published port). 127.0.0.1 keeps it private to the
# host; set WEB_BIND=0.0.0.0 only behind a firewall/VPN or TLS reverse proxy.
WEB_BIND=127.0.0.1
WEB_PORT=3000

POSTGRES_USER=agentic
POSTGRES_DB=agentic
POSTGRES_PASSWORD=change-me-postgres

RABBITMQ_USER=agentic
RABBITMQ_PASSWORD=change-me-rabbitmq

JWT_SECRET=change-me-jwt-secret-at-least-32-chars
SANDBOX_TOKEN=change-me-sandbox-token

# First administrator (created on first start).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# Optional OpenAI-compatible model endpoint (vLLM, Ollama, OpenAI, ...).
# Leave empty to configure providers in the UI. The key stays server-side.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

WORKER_CONCURRENCY=4
WORKER_REPLICAS=1
OTEL_EXPORTER_OTLP_ENDPOINT=
